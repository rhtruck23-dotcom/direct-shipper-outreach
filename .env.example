# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Optional — Google Places (New) API key for Find Leads search
GOOGLE_PLACES_API_KEY=

# Optional — override SMTP password instead of typing it in the UI
SMTP_PASSWORD=

# Optional — Twilio SMS when bot escalates to you (leave blank for email-only alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_SMS_NUMBER=
