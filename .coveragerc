# Coverage config — business logic in src/
# Streamlit page modules omitted (UI wiring; covered by E2E UAT, not unit tests)
# fail_under ~90 accepted (coverage chase to 96 abandoned)
[run]
source = src
branch = False
omit =
    src/__init__.py
    src/carrier_pages.py
    src/project_x/pages.py
    src/crm_ui.py
    src/notes_ui.py
    # Pure Streamlit HTML/JS inject glue (DOM chrome); logic lives in notes.py
    src/floating_chrome.py

[report]
precision = 1
show_missing = True
skip_empty = True
fail_under = 90
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
